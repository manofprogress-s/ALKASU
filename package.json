{
  "name": "alkasu",
  "version": "0.1.0",
  "private": true,
  "description": "Alay Ticaret stok, satış, kasa ve yönetim uygulaması",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "bash scripts/test-db.sh",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/database.types.ts",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.mjs",
    "template": "python3 templates/generate_template.py"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  }
}
